---
import Navigation from './Navigation.astro';
---

<header class="header">
  <div class="container">
    <div class="row flex-end">
      <button
        type="button"
        class="nav-toggler"
        aria-label="Open navigation"
        aria-expanded="false"
        aria-controls="primary-navigation"
      >
        <span aria-hidden="true"></span>
      </button>
      <Navigation />
    </div>
  </div>
</header>
